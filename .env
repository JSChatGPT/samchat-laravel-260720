SAMPAY_CLIENT_ID=2
SAMPAY_CLIENT_SECRET=BQuCycDbhyjKEIbVjWZKvwVmPnj7YIBcnUBiq255
SAMPAY_BASE_URL=http://192.168.208.137:8001/
SAMPAY_REDIRECT_URI=http://192.168.208.137:8000/api/sampay/callback

# Path to a Firebase service-account JSON file for sending push notifications.
# Leave empty locally; push sending will no-op gracefully until this is set.
FIREBASE_CREDENTIALS=samchat_firebase.json

# Pusher Channels (pusher.com) — create an app in the Pusher dashboard and
# fill these in from Channels > App Keys before running the app.
PUSHER_APP_ID=2175894
PUSHER_APP_KEY=a0c6fe77c87e5dd86809
PUSHER_APP_SECRET=76041d6477c273672f40
PUSHER_APP_CLUSTER=ap2

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Cloudflare Realtime TURN (calls.samchat) — create a free "Realtime TURN"
# App at dash.cloudflare.com > Realtime > TURN Service to get these. Without
# them, calls fall back to STUN-only and will fail whenever a direct P2P path
# is blocked (e.g. either caller is on mobile data or a restrictive Wi-Fi).
CLOUDFLARE_TURN_KEY_ID=e256c8c48b957933eee7b4de80e50932
CLOUDFLARE_TURN_API_TOKEN=0a6c133190905b8ec042ee864cc36b5ede8155f95d0f7807537dd230b8dbc40f

# MTN Ngage Enterprise Messaging (https://cpassmessaging.mtn.zm) — sends the
# real OTP SMS for phone verification (see App\Services\MtnSmsService).
# email/password are your enterprise account login (used to obtain a JWT,
# not sent per-message); sender_id must already be registered on that
# account. Leave these blank and OTP sending will fail closed (requestOtp
# logs the failure but does not error the API response) rather than fall
# back to any mock code.
MTN_SMS_BASE_URL=https://cpassmessaging.mtn.zm
MTN_SMS_EMAIL=
MTN_SMS_PASSWORD=
MTN_SMS_SENDER_ID=

# A single fixed phone number + code that Play/App Store reviewers can sign
# in with, without a real SMS round trip to a device they don't control
# (see OtpService). test_phone MUST already be a real registered user
# (create one through the normal /auth/register flow first) — this bypass
# never applies to any other number. Give this exact phone+code to Google
# in Play Console > App content > App access instructions.
PLAY_REVIEW_TEST_PHONE=
PLAY_REVIEW_TEST_OTP=




